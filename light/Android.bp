cc_binary {
    name: "android.hardware.lights-service.RMX2195",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights-RMX2195.rc"],
    vintf_fragments: ["android.hardware.lights-RMX2195.xml"],
    vendor: true,
    shared_libs: [
        "libbase",
        "liblog",
        "libhardware",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk_platform",
    ],
    srcs: [
        "Lights.cpp",
        "main.cpp",
    ],
}
